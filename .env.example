# Set these in Vercel environment settings, never in public frontend files.
APP_ORIGIN=https://ecg-learning-studio.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A base64url-encoded 32-byte cryptographically random key.
SESSION_SECRET=
ADMIN_EMAIL=
DRIVE_FOLDER_ID=
# JSON object mapping public source IDs to private Drive IDs.
DRIVE_SOURCE_IDS={}

# Optional AI tutor. Leave disabled until owner approves usage costs.
TUTOR_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
